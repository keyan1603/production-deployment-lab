{
 "uid": "ai-system",
 "title": "AI system",
 "tags": [
  "ai",
  "slo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Tickets per minute, by outcome",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (action) (rate(ai_ticket_outcomes_total[1m])) * 60",
     "legendFormat": "{{action}}"
    }
   ]
  },
  {
   "id": 2,
   "title": "Safe-completion SLI (5m, released or escalated)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.9
       },
       {
        "color": "green",
        "value": 0.97
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "1 - slo:error_ratio:ticket_safe_completion:5m",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "title": "Answer-quality probes correct (last 12)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.9
       },
       {
        "color": "green",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ai_probe_correct_ratio",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "title": "Drift verdict",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "stable",
         "color": "green"
        },
        "1": {
         "text": "warn",
         "color": "yellow"
        },
        "2": {
         "text": "critical",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ai_drift_verdict",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "title": "Restricted facts leaked (15m)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(increase(ai_probe_leaks_total[15m])) or vector(0)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "title": "Ticket latency p50 / p95 (seconds)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(ai_ticket_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_ticket_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 7,
   "title": "Model calls per minute, by route and tier",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (route, tier) (rate(ai_gateway_requests_total[1m])) * 60",
     "legendFormat": "{{route}} ({{tier}})"
    }
   ]
  },
  {
   "id": 8,
   "title": "Tokens per minute",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (direction) (rate(ai_gateway_tokens_total[1m])) * 60",
     "legendFormat": "{{direction}}"
    }
   ]
  },
  {
   "id": 9,
   "title": "Error-budget burn rate (5m; 1 = budget lasts exactly the SLO period)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "slo:error_ratio:ticket_availability:5m / 0.01",
     "legendFormat": "ticket_availability"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "slo:error_ratio:ticket_safe_completion:5m / 0.1",
     "legendFormat": "ticket_safe_completion"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "slo:error_ratio:ticket_latency:5m / 0.05",
     "legendFormat": "ticket_latency"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "slo:error_ratio:answer_quality_probe:5m / 0.05",
     "legendFormat": "answer_quality_probe"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "slo:error_ratio:no_degraded_tier:5m / 0.01",
     "legendFormat": "no_degraded_tier"
    }
   ]
  },
  {
   "id": 10,
   "title": "Cost, USD per hour",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 6,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(ai_gateway_cost_usd_total[5m])) * 3600",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 11,
   "title": "Circuit breaker (0 closed, 1 half-open, 2 open)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 14,
    "w": 6,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "max by (route) (ai_gateway_breaker_state)",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 12,
   "title": "Agent runs and tool calls per minute (emitted by Requisite itself)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (agent) (rate(requisite_agent_runs_total[1m])) * 60",
     "legendFormat": "runs: {{agent}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (tool) (rate(requisite_agent_tool_calls_total[1m])) * 60",
     "legendFormat": "tool: {{tool}}"
    }
   ]
  },
  {
   "id": 13,
   "title": "Release serving",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "max by (release, role, digest) (ai_release_serving)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 14,
   "title": "Alerts firing",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 21,
    "w": 16,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (alertname, severity) (ALERTS{alertstate=\"firing\"})",
     "legendFormat": ""
    }
   ]
  }
 ]
}